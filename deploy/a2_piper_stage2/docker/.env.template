# Generate docker/.env with scripts/configure_policy_host.sh. The values below
# match the already-observed deployment laptop, but the configure command still
# requires the operator to state --iface, --host-ip, and --domain-id explicitly.

A2_BASE_IMAGE=a2-humble-deploy:2026-06-05
A2_PIPER_STAGE2_IMAGE=a2-piper-stage2:humble-torch2.7.0-cpu
A2_DOCKER_PLATFORM=linux/amd64
TORCH_VERSION=2.7.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
LIBTORCH_URL=https://download.pytorch.org/libtorch/cpu/libtorch-cxx11-abi-shared-with-deps-2.7.0%2Bcpu.zip
NUMPY_VERSION=1.26.0
PYYAML_VERSION=6.0.2

POLICY_BUNDLE_DIR=/absolute/path/to/deploy/a2_piper_stage2/policy_bundle
SITE_CONFIG_FILE=/absolute/path/to/deploy/a2_piper_stage2/config/site.mock.yaml
EVIDENCE_DIR=/absolute/path/to/deploy/a2_piper_stage2/evidence

A2_NET_IFACE=enp130s0
POLICY_HOST_IPV4=192.168.123.222/24
ROS_DOMAIN_ID=0
A2_LOWSTATE_TOPIC=/lowstate
A2_LOWCMD_TOPIC=/lowcmd

# CUDA deployment is intentionally disabled until a matching, verified
# cxx11-ABI LibTorch 2.7 package is selected for the C++ runtime.
