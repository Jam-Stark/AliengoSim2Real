<launch>
    <!-- ============================================================ -->
    <!-- Aliengo Deploy 模拟测试（无实机版）                             -->
    <!--                                                                -->
    <!-- 启动两个节点:                                                   -->
    <!--   1. aliengo_deploy (策略推理节点)                               -->
    <!--   2. low_cmd_monitor (验证输出)                                 -->
    <!--                                                                -->
    <!-- fake_low_state_publisher 需要键盘交互，须在单独终端启动:          -->
    <!--   rosrun aliengo_deploy fake_low_state_publisher                -->
    <!--                                                                -->
    <!-- 完整测试 3 步:                                                  -->
    <!--   终端1: roslaunch aliengo_deploy test_deploy.launch            -->
    <!--          policy_path:=/work/AliengoSim2Real/policy/aliengo_new/ -->
    <!--   终端2: rosrun aliengo_deploy fake_low_state_publisher         -->
    <!--   终端3: (可选) rostopic echo /low_cmd                         -->
    <!--                                                                -->
    <!-- 在 fake_low_state_publisher 终端:                               -->
    <!--   a=使能  b=停止  e=急停  w/x=前后  d/c=转向  q=退出           -->
    <!-- ============================================================ -->

    <arg name="policy_path" default=""/>
    <arg name="inference_device" default="cpu"/>
    <arg name="gait_frequency" default="2.0"/>
    <arg name="force_log_csv" default=""/>

    <!-- 1. Aliengo deploy node (策略推理) -->
    <node pkg="aliengo_deploy" type="aliengo_deploy" name="aliengo_deploy"
          output="screen">
        <param name="policy_path" value="$(arg policy_path)"
               if="$(eval arg('policy_path') != '')"/>
        <param name="inference_device" value="$(arg inference_device)"/>
        <param name="gait_frequency" value="$(arg gait_frequency)"/>
        <param name="use_local_gamepad" value="false"/>
        <param name="force_log_csv" value="$(arg force_log_csv)"
               if="$(eval arg('force_log_csv') != '')"/>
    </node>

    <!-- 2. Low cmd monitor (验证输出) -->
    <node pkg="aliengo_deploy" type="low_cmd_monitor" name="low_cmd_monitor"
          output="screen"/>

</launch>
