<launch>
    <!-- ============================================================ -->
    <!-- Aliengo ROS1 RL Policy Deployment                            -->
    <!--                                                                -->
    <!-- Launches:                                                      -->
    <!--   1. unitree_legged_real/ros_udp (UDP bridge to Aliengo)      -->
    <!--   2. aliengo_deploy (RL policy control node)                   -->
    <!-- ============================================================ -->

    <!-- Arguments -->
    <arg name="ctrl_level" default="LOWLEVEL"/>
    <arg name="policy_path" default=""/>
    <arg name="inference_device" default="cpu"/>
    <arg name="gait_frequency" default="2.0"/>
    <arg name="use_local_gamepad" default="false"/>

    <!-- 1. Unitree ROS1 UDP Bridge (low-level) -->
    <node pkg="unitree_legged_real" type="ros_udp" name="ros_udp"
          output="screen" args="$(arg ctrl_level)"/>

    <!-- 2. Aliengo Policy Deploy Node -->
    <node pkg="aliengo_deploy" type="aliengo_deploy" name="aliengo_deploy"
          output="screen">
        <param name="policy_path" value="$(arg policy_path)"
               if="$(eval arg('policy_path') != '')"/>
        <param name="inference_device" value="$(arg inference_device)"/>
        <param name="gait_frequency" value="$(arg gait_frequency)"/>
        <param name="use_local_gamepad" value="$(arg use_local_gamepad)"/>
    </node>

</launch>
