# A2 remote policy run config.
# Bash .env format; loaded by a2_real_robot_test.sh policy subcommands and
# guarded pose-hold.
#
# Do NOT put A2_ALLOW_ENABLE_MOTION=1 or A2_ALLOW_POSE_LOWCMD=1 in this config.
# Real LowCmd publish guards must stay operator shell decisions at command time.

A2_POLICY_MAX_REMOTE_VX=0.80
A2_POLICY_MAX_REMOTE_VY=0.50
A2_POLICY_MAX_REMOTE_YAW=0.6
A2_POLICY_REMOTE_DEADZONE=0.08
A2_POLICY_REQUIRE_STANDUP_BEFORE_POLICY=true
A2_POLICY_PUBLISH_AUX_DEBUG=true
A2_POLICY_AUX_DEBUG_TOPIC=/a2/policy_aux
A2_POLICY_AUX_EXPECTED_DIM=6
A2_POLICY_AUX_PRINT_PERIOD=0.2
A2_POLICY_BRAKE_GATE_ENABLED=true
A2_POLICY_BRAKE_FORCE_X_THRESHOLD=-0.6
A2_POLICY_BRAKE_MIN_CMD_VX=0.2
A2_POLICY_BRAKE_MAX_ABS_YAW=0.10
A2_POLICY_BRAKE_HOLD_STEPS=2
A2_POLICY_STOP_POSE_KP=20.0
A2_POLICY_STOP_POSE_KD=2.0
A2_POLICY_STOP_POSE_INTERPOLATE_SEC=2.0

# Stop pose Q is explicit-only. The repo default intentionally does not set
# A2_POLICY_STOP_POSE_Q, so forgetting the target cannot move the robot.
# Example policy default mapped to A2 low-level order:
# A2_POLICY_STOP_POSE_Q='[0.0,0.5,-1.0,0.0,0.5,-1.0,0.0,0.5,-1.0,0.0,0.5,-1.0]'

# Brake gate uses active /a2/policy_aux dim 6:
# pred_base_lin_vel[0..2] + pred_base_force_local[0..2].
# A2_POLICY_BRAKE_FORCE_X_THRESHOLD is the observed unitless policy aux scale,
# not Newton. Negative threshold means pred_base_force_local[0] <= threshold.
